generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Member {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  memberNumber   String    @unique
  name           String
  email          String    @unique
  phone          String    @default("")
  address        String    @default("")
  studioName     String    @default("")
  aadhaarNumber  String    @default("")
  udyamAadhaar   String    @default("")
  membershipFee  Float     @default(0)
  membershipPeriodYears Int @default(1)
  experienceYears Int      @default(0)
  bloodGroup     String    @default("")
  professions    String[]  @default([])
  camerasUsed    String[]  @default([])
  photoUrl       String    @default("")
  aadhaarPhotoUrl String   @default("")
  udyamAadhaarPhotoUrl String @default("")
  membershipType String    @default("Annual")
  registrationDate DateTime @default(now())
  joinedAt       DateTime  @default(now())
  expiresAt      DateTime?
  status         String    @default("Pending")
  deletedAt      DateTime?

  @@map("members")
}

model Workshop {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  date            DateTime
  venue           String
  registrationFee Float
  description     String
  mentorName      String
  time            String
  venueFee        Float?
  mentorFee       Float?
  foodExpense     Float?
  advertisingExpense Float?
  sponsors        String[] @default([])
  arrangedBy      String?
  anchorName      String?
  guestName       String?
  imageUrls       String[] @default([])
  imagePublicIds  String[] @default([])
  status          String   @default("Planning")
  createdAt       DateTime @default(now())
  deletedAt       DateTime?

  @@map("workshops")
}

model Registration {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  registrationNumber String   @unique
  memberId           String   @db.ObjectId
  memberNumber       String
  memberName         String
  memberEmail        String
  workshopId         String   @db.ObjectId
  workshopTitle      String
  registeredAt       DateTime @default(now())
  amount             Float
  paymentStatus      String   @default("Pending")
  attendanceStatus   String   @default("Registered")

  @@map("registrations")
}
